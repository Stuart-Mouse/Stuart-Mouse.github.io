player_animations: {
    STAND: {
        flags:  .LOOP,
        frames: {
            { offset: {-4,-11}, clip: { 240,   32,    8, 16 }, duration: 0.3*0.7 },
            { offset: {-4,-11}, clip: { 240,   32+16, 8, 16 }, duration: 0.25*0.7 },
            { offset: {-4,-11}, clip: { 240,   32,    8, 16 }, duration: 0.3*0.7 },
            { offset: {-4,-11}, clip: { 240+8, 32+16, 8, 16 }, duration: 0.25*0.7 },
        }
