engine: {
    emulated_crt_screen_width:  320,
    emulated_crt_screen_height: 240,
    
    window_width:      640 * 2,
    window_height:     480 * 2,
    
    target_frames_per_second:   60,
    vsync_enabled:              true,
    
    render_clear_color:     { 0.2, 0.2, 0.2, 1 },
    
    disable_crt_shader:     false,
}

